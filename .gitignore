pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
htmlcov/
.hypothesis/

# Django specific
*.sqlite3
db.sqlite3
*.pyc
staticfiles/
mediafiles/
media/
local_settings.py

